#tag EndDesktopWindow

#tag WindowCode
	#tag Method, Flags = &h0
		Sub ApplyLanguage()
		  // The buttons in the current language (Strings)
		  btnNarrower.Caption = T("glyph.narrower")
		  btnWider.Caption = T("glyph.wider")
		  btnClear.Caption = T("glyph.clear")
		  btnRevert.Caption = T("glyph.revert")
		  btnCancel.Caption = T("button.cancel")
		  btnOK.Caption = T("button.ok")
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function CellAt(x As Integer, y As Integer, ByRef cx As Integer, ByRef cy As Integer) As Boolean
		  // The grid cell under a point of cvEdit
		  Dim s As Integer = CellSize
		  cx = (x - kMargin) \ s
		  cy = (y - kMargin) \ s
		  Return x >= kMargin And y >= kMargin And cx >= 0 And cy >= 0 And cx < mCols And cy < mRows
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function CellSize() As Integer
		  Return Max(2, Min((cvEdit.Width - 2 * kMargin) \ Max(1, mCols), (cvEdit.Height - 2 * kMargin) \ Max(1, mRows)))
		End Function
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub EditGlyph(owner As MainWindow, current As GlyphBitmap, original As GlyphBitmap, sizePx As Integer, lineHeight As Integer, baseline As Integer)
		  // Opens the editor on a glyph: current (the glyph as it is now, maybe edited), original (as rendered from the font,
		  // for Revert; Nil when the font doesn't have it). The result goes back to owner.GlyphEdited
		  mOwner = owner
		  mOriginal = original
		  mSizePx = sizePx
		  mLineHeight = lineHeight
		  mBaseline = baseline
		  mCodePoint = current.CodePoint
		  Load(current)
		  Self.Title = Chr(mCodePoint) + "   U+" + Hex4(mCodePoint) + "   " + Str(sizePx) + " px"
		  ApplyLanguage
		  Self.ShowModal(owner)
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function Hex4(cp As Integer) As String
		  Dim h As String = Hex(cp)
		  While h.Length < 4
		    h = "0" + h
		  Wend
		  Return h
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub Load(g As GlyphBitmap)
		  // The glyph on a grid that covers its line box, with room left of the pen and past the advance
		  mAdvance = g.Advance
		  Dim leftEdge As Integer = Min(0, g.XOffset) - 1
		  Dim rightEdge As Integer = Max(Max(mAdvance, g.XOffset + g.Width), mSizePx) + 2
		  Dim topEdge As Integer = Min(0, g.YOffset)
		  Dim bottomEdge As Integer = Max(mLineHeight, g.YOffset + g.Height)
		  mPenCol = -leftEdge
		  mTopRow = -topEdge
		  mCols = rightEdge - leftEdge
		  mRows = bottomEdge - topEdge
		  mCells = New MemoryBlock(mCols * mRows)
		  For y As Integer = 0 To g.Height - 1
		    For x As Integer = 0 To g.Width - 1
		      If g.Pixel(x, y) Then mCells.Byte((mTopRow + g.YOffset + y) * mCols + mPenCol + g.XOffset + x) = 1
		    Next
		  Next
		  cvEdit.Refresh
		  cvActual.Refresh
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub Shift(dx As Integer, dy As Integer)
		  // Moves the ink by one pixel (what leaves the grid is lost)
		  Dim m As New MemoryBlock(mCols * mRows)
		  For y As Integer = 0 To mRows - 1
		    For x As Integer = 0 To mCols - 1
		      Dim nx As Integer = x + dx
		      Dim ny As Integer = y + dy
		      If mCells.Byte(y * mCols + x) <> 0 And nx >= 0 And ny >= 0 And nx < mCols And ny < mRows Then m.Byte(ny * mCols + nx) = 1
		    Next
		  Next
		  mCells = m
		  cvEdit.Refresh
		  cvActual.Refresh
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Function ToGlyph() As GlyphBitmap
		  // The grid as a glyph, cropped to its ink
		  Dim g As New GlyphBitmap(mCols, mRows)
		  For y As Integer = 0 To mRows - 1
		    For x As Integer = 0 To mCols - 1
		      If mCells.Byte(y * mCols + x) <> 0 Then g.Pixel(x, y) = True
		    Next
		  Next
		  g.CodePoint = mCodePoint
		  g.Advance = mAdvance
		  g.XOffset = -mPenCol
		  g.YOffset = -mTopRow
		  g.Edited = True
		  g.Crop
		  Return g
		End Function
	#tag EndMethod


	#tag Property, Flags = &h21
		Private mAdvance As Integer
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mBaseline As Integer
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mCells As MemoryBlock
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mCodePoint As Integer
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mCols As Integer
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mLineHeight As Integer
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mOriginal As GlyphBitmap
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mOwner As MainWindow
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mPaintValue As Integer
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mPenCol As Integer
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mRows As Integer
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mSizePx As Integer
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mTopRow As Integer
	#tag EndProperty


	#tag Constant, Name = kMargin, Type = Double, Dynamic = False, Default = \"4", Scope = Private
	#tag EndConstant


#tag EndWindowCode

#tag Events cvEdit
	#tag Event
		Sub Paint(g As Graphics, areas() As Rect)
		  #Pragma Unused areas
		  g.DrawingColor = &cFFFFFF
		  g.FillRectangle(0, 0, g.Width, g.Height)
		  If mCells = Nil Then Return
		  Dim s As Integer = CellSize
		  // Lit pixels
		  g.DrawingColor = &c000000
		  For y As Integer = 0 To mRows - 1
		    For x As Integer = 0 To mCols - 1
		      If mCells.Byte(y * mCols + x) <> 0 Then g.FillRectangle(kMargin + x * s, kMargin + y * s, s, s)
		    Next
		  Next
		  // Grid
		  g.DrawingColor = &cDDDDDD
		  For x As Integer = 0 To mCols
		    g.DrawLine(kMargin + x * s, kMargin, kMargin + x * s, kMargin + mRows * s)
		  Next
		  For y As Integer = 0 To mRows
		    g.DrawLine(kMargin, kMargin + y * s, kMargin + mCols * s, kMargin + y * s)
		  Next
		  // The line box, the baseline (red), the pen (blue) and the advance (green)
		  g.DrawingColor = &c9999FF
		  g.DrawRectangle(kMargin, kMargin + mTopRow * s, mCols * s + 1, mLineHeight * s + 1)
		  g.DrawingColor = &cE03030
		  g.DrawLine(kMargin, kMargin + (mTopRow + mBaseline) * s, kMargin + mCols * s, kMargin + (mTopRow + mBaseline) * s)
		  g.DrawingColor = &c3060E0
		  g.DrawLine(kMargin + mPenCol * s, kMargin, kMargin + mPenCol * s, kMargin + mRows * s)
		  g.DrawingColor = &c20A040
		  g.DrawLine(kMargin + (mPenCol + mAdvance) * s, kMargin, kMargin + (mPenCol + mAdvance) * s, kMargin + mRows * s)
		End Sub
	#tag EndEvent
	#tag Event
		Function MouseDown(x As Integer, y As Integer) As Boolean
		  // A click toggles a pixel; dragging paints with the value the click set
		  Dim cx, cy As Integer
		  If Not CellAt(x, y, cx, cy) Then Return False
		  mPaintValue = If(mCells.Byte(cy * mCols + cx) <> 0, 0, 1)
		  mCells.Byte(cy * mCols + cx) = mPaintValue
		  cvEdit.Refresh
		  cvActual.Refresh
		  Return True
		End Function
	#tag EndEvent
	#tag Event
		Sub MouseDrag(x As Integer, y As Integer)
		  Dim cx, cy As Integer
		  If Not CellAt(x, y, cx, cy) Then Return
		  If mCells.Byte(cy * mCols + cx) = mPaintValue Then Return
		  mCells.Byte(cy * mCols + cx) = mPaintValue
		  cvEdit.Refresh
		  cvActual.Refresh
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events cvActual
	#tag Event
		Sub Paint(g As Graphics, areas() As Rect)
		  #Pragma Unused areas
		  // The glyph at 1:1, then 3x, on its line box
		  g.DrawingColor = &cFFFFFF
		  g.FillRectangle(0, 0, g.Width, g.Height)
		  If mCells = Nil Then Return
		  Dim scales() As Integer = Array(1, 3)
		  Dim x0 As Integer = 6
		  For Each s As Integer In scales
		    g.DrawingColor = &cE8E8FF
		    g.FillRectangle(x0, 6 + mTopRow * s, mCols * s, mLineHeight * s)
		    g.DrawingColor = &c000000
		    For y As Integer = 0 To mRows - 1
		      For x As Integer = 0 To mCols - 1
		        If mCells.Byte(y * mCols + x) <> 0 Then g.FillRectangle(x0 + x * s, 6 + y * s, s, s)
		      Next
		    Next
		    x0 = x0 + mCols * s + 12
		  Next
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnLeft
	#tag Event
		Sub Pressed()
		  Shift(-1, 0)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnRight
	#tag Event
		Sub Pressed()
		  Shift(1, 0)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnUp
	#tag Event
		Sub Pressed()
		  Shift(0, -1)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnDown
	#tag Event
		Sub Pressed()
		  Shift(0, 1)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnNarrower
	#tag Event
		Sub Pressed()
		  If mAdvance > 0 Then mAdvance = mAdvance - 1
		  cvEdit.Refresh
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnWider
	#tag Event
		Sub Pressed()
		  If mPenCol + mAdvance < mCols Then mAdvance = mAdvance + 1
		  cvEdit.Refresh
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnClear
	#tag Event
		Sub Pressed()
		  mCells = New MemoryBlock(mCols * mRows)
		  cvEdit.Refresh
		  cvActual.Refresh
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnRevert
	#tag Event
		Sub Pressed()
		  // Back to the glyph as rendered from the font (a blank one when the font doesn't have it)
		  If mOriginal <> Nil Then
		    Load(mOriginal)
		  Else
		    Dim blank As New GlyphBitmap(0, 0)
		    blank.CodePoint = mCodePoint
		    blank.Advance = mSizePx
		    Load(blank)
		  End If
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnCancel
	#tag Event
		Sub Pressed()
		  Self.Close
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnOK
	#tag Event
		Sub Pressed()
		  If mOwner <> Nil Then mOwner.GlyphEdited(mSizePx, ToGlyph)
		  Self.Close
		End Sub
	#tag EndEvent
#tag EndEvents
